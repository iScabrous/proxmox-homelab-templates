# Vaultwarden Configuration Template
# Copy this file to .env and configure your values

# Fully Qualified Domain Name (routed via Cloudflare Tunnel or reverse proxy)
VAULTWARDEN_DOMAIN=vault.example.com

# Disable public signups after creating your primary admin account
SIGNUPS_ALLOWED=false

# Argon2-hashed admin token for the /admin web interface
# Generate a secure hash via:
#   docker run --rm -it vaultwarden/server:latest /vaultwarden hash
# NOTE: In .env files, enclose the string in single quotes with single '$' characters
ADMIN_TOKEN='$argon2id$v=19$m=65536,t=3,p=4$CHANGE_ME_GENERATE_WITH_HASH_COMMAND'

# Host port binding (loopback-only recommended if routed via reverse proxy or tunnel)
HOST_PORT=8080
