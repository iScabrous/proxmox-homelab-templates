# Paperless-ngx Configuration Template
# Copy this file to .env and configure your values

PAPERLESS_DOMAIN=docs.example.com
PAPERLESS_PORT=8000

# Non-root user mapping (Least Privilege)
# Run 'id' on your Docker host and assign your local UID / GID
PUID=1000
PGID=1000

# Generate a 64-character random hex string (e.g. openssl rand -hex 32)
PAPERLESS_SECRET_KEY=change_me_to_a_long_random_hex_secret_key

TIME_ZONE=Europe/Berlin
OCR_LANG=deu+eng

# PostgreSQL database credentials (CHANGE THESE!)
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=generate_a_strong_database_password_here
